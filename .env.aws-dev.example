# ============================================================================
# AWS Dev RDS — Secrets Manager 기반 접속 환경변수
#
# 실제 .env.aws-dev 파일은 git commit 금지 (.gitignore에서 .env.* 패턴으로 차단됨)
# RDS endpoint 와 ARN 은 민감도가 낮지만, 일관성을 위해 본 파일은 placeholder 만 보관.
#
# 사용:
#   cp .env.aws-dev.example .env.aws-dev
#   # → .env.aws-dev를 실제 값으로 채우기
#   source scripts/aws-dev/load-master-secret.sh
#   dbmate up
# ============================================================================

AWS_PROFILE=projectrg
AWS_DEFAULT_REGION=ap-northeast-2

# RDS endpoint (Phase 2 생성 직후 채워넣음)
RDS_HOST=projectrg-dev-db-rds.XXXXXXXX.ap-northeast-2.rds.amazonaws.com
RDS_PORT=3306
RDS_DB_NAME=ProjectRG_Dev

# Master 패스워드 Secret ARN (RDS managed)
MASTER_SECRET_ARN=arn:aws:secretsmanager:ap-northeast-2:XXXXXXXXXXXX:secret:rds!db-XXXXXXXX

# App user 패스워드 Secret ARN (Phase 5에서 추가)
# APP_USER_SECRET_ARN=arn:aws:secretsmanager:ap-northeast-2:XXXXXXXXXXXX:secret:projectrg/dev/app-user-XXX
