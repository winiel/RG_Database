// ============================================================================
// ProjectRG — Phase 1 Initial Schema (DBML)
//
// dbdiagram.io에 import하면 ERD 시각화 가능. https://dbdiagram.io/d
// 진실 원천:   winiel/RG_Database/schema/schema.sql
// 회신 명세서: winiel/RG_Common/Document/RG_Database/2026-05-10-database-response-to-backend.md
//
// 정책 요약:
//   * Engine: MySQL 8.0+ (Aurora MySQL 3 호환)
//   * Charset: utf8mb4_0900_ai_ci
//   * PK:  binary(16) UUID — 앱(백엔드) 측 생성 (UUIDv7 권장)
//   * FK:  100% 미사용 (회신 §3-4) — 본 파일의 Ref는 시각화 전용 논리 참조
//   * 멀티테넌시: 모든 도메인 테이블 tenant_id NOT NULL + 인덱스 첫 컬럼
// ============================================================================

Project ProjectRG {
    database_type: 'MySQL'
    Note: '''
        ProjectRG database schema — Phase 1.
        FK는 DB에 선언되지 않습니다 (앱+CI 검증). 본 ERD의 Ref는 시각화 전용입니다.
    '''
}

TableGroup auth_tenancy [color: #3b82f6] {
    academies
    user_accounts
    refresh_tokens
}

TableGroup students_notes [color: #10b981] {
    students
    student_notes
}

TableGroup classes_master [color: #f59e0b] {
    subjects
    rooms
    teachers
    classes
    student_classes
    holidays
    class_cancellations
}

TableGroup attendance_vision [color: #8b5cf6] {
    attendances
    vision_verifications
}

TableGroup payments_events [color: #ef4444] {
    payments
    payment_events
    payment_adjustments
    billing_schedules
}

TableGroup ai_assistant [color: #14b8a6] {
    ai_assistant_unmet_requests
}

TableGroup notifications_settings [color: #06b6d4] {
    message_templates
    settings
    semesters
}

TableGroup abilities [color: #ec4899] {
    ability_tracks
    student_abilities
}

TableGroup uploads_meta [color: #6b7280] {
    uploads
}

TableGroup migration_meta [color: #9ca3af] {
    schema_migrations
}

// ─── §4.1 인증/테넌시 ─────────────────────────────────────────────────────────

Table academies {
    id binary(16) [pk, note: 'UUID — 앱 측 생성']
    name varchar(100) [not null]
    business_number varchar(20) [not null, unique]
    address varchar(255)
    phone varchar(20)
    email varchar(255)
    logo_url varchar(500)
    operating_hours json [note: 'JSON: {mon: "10:00-22:00", ...}']
    created_at datetime [not null, default: 'CURRENT_TIMESTAMP']
    updated_at datetime [not null, default: 'CURRENT_TIMESTAMP ON UPDATE']
    status varchar(16) [not null, default: 'pending', note: 'DB-13 학원 승인 상태. pending|active (CHECK chk_academies_status). 신규 self-signup=pending·기존 운영 학원=active. BE-38 승인 게이트: active만 로그인 허용']

    Note: '학원/테넌트 — 멀티테넌시 루트. 자기 자신이 테넌트라 tenant_id 컬럼 없음. 다른 테이블의 tenant_id는 academies.id를 가리키는 논리 참조'
}

Table user_accounts {
    id binary(16) [pk]
    tenant_id binary(16) [not null]
    email varchar(255) [not null, unique]
    password_hash varchar(255) [not null]
    name varchar(100) [not null]
    phone varchar(20)
    role varchar(20) [not null, default: 'owner', note: 'CHECK: owner']
    last_login_at datetime
    created_at datetime [not null]
    updated_at datetime [not null]

    Indexes {
        tenant_id [name: 'idx_user_accounts_tenant_id']
    }

    Note: '학원장 로그인 계정. MVP는 role=owner 단일'
}

Table refresh_tokens {
    id binary(16) [pk]
    tenant_id binary(16) [not null]
    user_account_id binary(16) [not null]
    token_hash varchar(255) [not null, unique]
    expires_at datetime [not null]
    revoked_at datetime
    created_at datetime [not null]
    updated_at datetime [not null]

    Indexes {
        (tenant_id, user_account_id) [name: 'idx_refresh_tokens_tenant_id_user_account_id']
        expires_at [name: 'idx_refresh_tokens_expires_at']
    }

    Note: 'JWT refresh token 폐기 추적. 만료/탈취 대응'
}

// ─── §4.2 학생/메모 ──────────────────────────────────────────────────────────

Table students {
    id binary(16) [pk]
    tenant_id binary(16) [not null]
    person_id binary(16) [not null, note: 'Phase 5 — 글로벌 persons FK (1:1 backfill 2026-05-28)']
    name varchar(100) [not null]
    birth_date date
    school_name varchar(100)
    grade varchar(20)
    profile_image_url varchar(500)
    address varchar(255)
    phone varchar(20) [note: '학생 본인 phone (Q-2 — 동명이인 식별, NULL 허용)']
    registered_at datetime [not null, default: 'CURRENT_TIMESTAMP']
    status varchar(20) [not null, default: 'active', note: 'CHECK: active|paused|withdrawn']
    parent json [note: 'JSON: {name, relation, phone, ...}']
    parent_name varchar(100) [note: '학부모명 평탄화 (검색용)']
    parent_phone varchar(20) [note: '학부모 전화 평탄화 (lookup용)']
    is_deleted tinyint(1) [not null, default: 0, note: '논리삭제 플래그 (DB-9). 0=활성 1=삭제']
    deleted_at datetime [note: '삭제 시각 (논리삭제 DB-9)']
    deleted_by binary(16) [note: '삭제 주체 uuid (논리삭제 DB-9)']
    active_uk_token binary(16) [note: 'GENERATED VIRTUAL = IF(is_deleted=0, tenant_id, NULL) (DB-9). active 행만 유니크 참여·삭제 행 면제']
    created_at datetime [not null]
    updated_at datetime [not null]

    Indexes {
        (name, phone, active_uk_token) [unique, name: 'uk_students_tenant_name_phone', note: 'DB-9 — active(is_deleted=0) 행만 (tenant_id,name,phone) 유니크. 삭제 행은 token=NULL 로 면제·동명/동번호 재등록 허용']
        (tenant_id, status) [name: 'idx_students_tenant_id_status']
        (tenant_id, parent_phone) [name: 'idx_students_tenant_id_parent_phone']
        (tenant_id, name) [name: 'idx_students_tenant_id_name']
        person_id [name: 'idx_students_person_id']
    }

    Note: '학생 (Phase 5 — person_id 추가, 1:1 backfill / BEFORE INSERT trigger 로 person_id 미명시 시 자동 person 생성)'
}

// TRIGGER trg_students_auto_person_id (BEFORE INSERT ON students)
// person_id IS NULL 시 신규 persons row 생성 (name + birth_date 복사) 후 NEW.person_id 연결.
// person_id 명시 시 (학원장 수동 통합 / merge-person endpoint) 그대로 통과.
// B8 X 정합 — Backend INSERT 통합 테스트 17건 자동 복원 (코드 변경 0).
// 마이그: 20260528123600_add_auto_person_id_trigger_to_students

Table student_notes {
    id binary(16) [pk]
    tenant_id binary(16) [not null]
    student_id binary(16) [not null]
    content text
    created_at datetime [not null]
    updated_at datetime [not null]

    Indexes {
        (tenant_id, student_id) [unique, name: 'uq_student_notes_tenant_id_student_id']
    }

    Note: '학원장 메모 (학생 1:1)'
}

// ─── §4.3 클래스/강사/마스터 ─────────────────────────────────────────────────

Table subjects {
    id binary(16) [pk]
    tenant_id binary(16) [not null]
    name varchar(50) [not null]
    color_token varchar(30) [note: 'UI 색상 토큰']
    created_at datetime [not null]
    updated_at datetime [not null]

    Indexes {
        (tenant_id, name) [unique, name: 'uq_subjects_tenant_id_name']
    }

    Note: '종목 마스터'
}

Table rooms {
    id binary(16) [pk]
    tenant_id binary(16) [not null]
    name varchar(50) [not null]
    description varchar(255)
    created_at datetime [not null]
    updated_at datetime [not null]

    Indexes {
        (tenant_id, name) [unique, name: 'uq_rooms_tenant_id_name']
    }

    Note: '강의실 마스터'
}

Table teachers {
    id binary(16) [pk]
    tenant_id binary(16) [not null]
    name varchar(100) [not null]
    subject_id binary(16) [note: '주 종목 (NULL 허용)']
    profile_image_url varchar(500)
    phone varchar(20)
    email varchar(255)
    employment_type varchar(20) [not null, default: 'full_time', note: 'CHECK: full_time|part_time|contract']
    hourly_rate decimal(10,2)
    joined_at datetime [not null, default: 'CURRENT_TIMESTAMP']
    status varchar(20) [not null, default: 'active', note: 'CHECK: active|inactive|resigned']
    memo text [note: '학원장 자유 메모 (multi-line 허용)']
    is_deleted tinyint(1) [not null, default: 0, note: '논리삭제 플래그 (DB-9). 0=활성 1=삭제']
    deleted_at datetime [note: '삭제 시각 (논리삭제 DB-9)']
    deleted_by binary(16) [note: '삭제 주체 uuid (논리삭제 DB-9)']
    created_at datetime [not null]
    updated_at datetime [not null]

    Indexes {
        (tenant_id, status) [name: 'idx_teachers_tenant_id_status']
        (tenant_id, subject_id) [name: 'idx_teachers_tenant_id_subject_id']
    }

    Note: '강사'
}

Table classes {
    id binary(16) [pk]
    tenant_id binary(16) [not null]
    name varchar(100) [not null]
    subject_id binary(16)
    teacher_id binary(16)
    room_id binary(16) [note: 'NULL 허용 (강의실 미지정)']
    days_of_week json [note: 'NULL 허용 (20260610). JSON: ISO 요일 배열 [1,3,5] = 월수금. CHECK: NULL OR JSON_LENGTH >= 1']
    start_date date [note: 'NULL 허용. 클래스 운영 시작일 (20260610 신설)']
    end_date date [note: 'NULL 허용. 클래스 운영 종료일 (20260610 신설). CHECK: NULL 관대, end_date >= start_date']
    start_time time
    end_time time
    capacity int [note: 'unsigned, 정원']
    status varchar(20) [not null, default: 'active', note: 'CHECK: active|paused|ended|archived']
    started_at datetime
    is_deleted tinyint(1) [not null, default: 0, note: '논리삭제 플래그 (DB-9). 0=활성 1=삭제']
    deleted_at datetime [note: '삭제 시각 (논리삭제 DB-9)']
    deleted_by binary(16) [note: '삭제 주체 uuid (논리삭제 DB-9)']
    created_at datetime [not null]
    updated_at datetime [not null]

    Indexes {
        (tenant_id, status) [name: 'idx_classes_tenant_id_status']
        (tenant_id, subject_id) [name: 'idx_classes_tenant_id_subject_id']
        (tenant_id, teacher_id) [name: 'idx_classes_tenant_id_teacher_id']
        (tenant_id, room_id) [name: 'idx_classes_tenant_id_room_id']
        (tenant_id, status, end_date) [name: 'idx_classes_tenant_status_end_date']
        (tenant_id, start_date) [name: 'idx_classes_tenant_start_date']
    }

    Note: '클래스'
}

Table student_classes {
    id binary(16) [pk]
    tenant_id binary(16) [not null]
    student_id binary(16) [not null]
    class_id binary(16) [not null]
    enrolled_at datetime [not null, default: 'CURRENT_TIMESTAMP']
    unenrolled_at datetime
    status varchar(20) [not null, default: 'active', note: 'CHECK: active|unenrolled|completed']
    attending_days_of_week json [note: 'NULL 허용 (DB-30, 20260621). NULL=클래스 전 요일 추종(현행). 값=부분집합 JSON 배열 0=일~6=토. CHECK: NULL OR JSON_LENGTH >= 1. 요소범위/부분집합은 BE-53 런타임']
    created_at datetime [not null]
    updated_at datetime [not null]

    Indexes {
        (tenant_id, student_id, class_id) [unique, name: 'uq_student_classes_tenant_id_student_id_class_id']
        (tenant_id, class_id) [name: 'idx_student_classes_tenant_id_class_id']
    }

    Note: '학생-클래스 등록 (N:M)'
}

Table holidays {
    id binary(16) [pk]
    tenant_id binary(16) [not null]
    date date [not null]
    name varchar(100) [not null]
    type varchar(20) [not null, default: 'academy', note: 'CHECK: public|academy|special']
    created_at datetime [not null]
    updated_at datetime [not null]

    Indexes {
        (tenant_id, date) [unique, name: 'uq_holidays_tenant_id_date']
    }

    Note: '휴무일'
}

Table class_cancellations {
    id binary(16) [pk]
    tenant_id binary(16) [not null]
    class_id binary(16) [not null]
    cancelled_date date [not null, note: '휴강일 (날짜 단위, 시간 성분 없음)']
    reason varchar(255) [note: 'NULL 허용. 휴강 사유 (예: 공휴일, 강사 사정)']
    created_at datetime [not null]
    updated_at datetime [not null]

    Indexes {
        (tenant_id, class_id, cancelled_date) [unique, name: 'uq_class_cancellations_tenant_id_class_id_cancelled_date']
        (tenant_id, cancelled_date) [name: 'idx_class_cancellations_tenant_id_cancelled_date']
    }

    Note: '클래스 휴강 — 반복 클래스의 특정 날짜 1회 수업 취소 기록 (폐강=classes.status ended 와 별개). undo=행 삭제(옵션 A). 출석 집계 제외는 런타임(Backend BE-21)'
}

// ─── §4.4 출결/Vision ────────────────────────────────────────────────────────

Table vision_verifications {
    id binary(16) [pk]
    tenant_id binary(16) [not null]
    student_id binary(16) [not null]
    image_url varchar(500) [not null]
    confidence decimal(5,4) [note: 'CHECK: 0~1, NULL 허용']
    verified_at datetime [not null, default: 'CURRENT_TIMESTAMP']
    created_at datetime [not null]
    updated_at datetime [not null]

    Indexes {
        (tenant_id, student_id, verified_at) [name: 'idx_vision_verifications_tenant_id_student_id_verified_at']
    }

    Note: 'Vision AI 인증 결과 (별도 모듈에서 INSERT)'
}

Table attendances {
    id binary(16) [pk]
    tenant_id binary(16) [not null]
    student_id binary(16) [not null]
    class_id binary(16) [not null]
    date date [not null]
    attendance_status varchar(20) [not null, note: 'CHECK: present|late|absent|excused']
    check_in_at datetime [note: 'present/late일 때만 채움']
    vision_verification_id binary(16) [note: 'NULL 허용 (Vision 미사용 출결)']
    absence_reason varchar(255)
    memo varchar(500) [note: '수업 일지 (강사·원장이 매 수업 종료 후 학생 단위 기록) — 2026-05-28']
    absence_category varchar(20) [note: 'CHECK: NULL or sick|family|travel|school|other (school 추가: 2026-05-10 RG_Director 요청)']
    is_absence_notified_in_advance boolean [not null, default: 'FALSE']
    created_via varchar(20) [not null, default: 'manual', note: 'CHECK: manual|auto|vision|ai — 자동 출결 옵션 β (N10, 2026-05-29). cron INSERT 시 auto + confirmed_at=cron_run_at (Backend 옵션 Y)']
    confirmed_at datetime [note: 'D6 chip tooltip 시각. cron 자동 처리 시 cron_run_at / 학원장 입력·정정 시 NOW() / 학원장 미확인 시 NULL']
    confirmed_by binary(16) [note: '학원장 user_id (멀티 RBAC 미래 호환). NULL = 학원장 미확인 (dashboard auto_confirm_pending_count 분기 기준)']
    created_at datetime [not null]
    updated_at datetime [not null]

    Indexes {
        (tenant_id, student_id, class_id, date) [unique, name: 'uq_attendances_tenant_id_student_id_class_id_date']
        (tenant_id, class_id, date) [name: 'idx_attendances_tenant_id_class_id_date']
        (tenant_id, student_id, date) [name: 'idx_attendances_tenant_id_student_id_date']
    }

    Note: '출결'
}

// ─── §4.5 결제/이력 ──────────────────────────────────────────────────────────

Table payments {
    id binary(16) [pk]
    tenant_id binary(16) [not null]
    student_id binary(16) [not null]
    class_id binary(16) [note: 'NULL 허용 (전체 학원비 등)']
    billing_item varchar(100) [not null]
    billing_breakdown json [note: 'JSON: {tuition, discount, extra, ...}']
    amount decimal(12,2) [not null, note: 'CHECK: >= 0']
    billing_date date [not null]
    due_date date
    paid_date date
    payment_method varchar(20) [note: 'CHECK: NULL or cash|card|transfer|auto_debit']
    payment_status varchar(20) [not null, default: 'pending', note: 'CHECK: pending|paid|overdue|cancelled|refunded']
    refunded_amount decimal(12,2) [not null, default: 0, note: 'CHECK: 0 <= refunded_amount <= amount. 누적 환급 금액 (v1 부분 환급 X 옵션)']
    created_at datetime [not null]
    updated_at datetime [not null]

    Indexes {
        (tenant_id, billing_date) [name: 'idx_payments_tenant_id_billing_date']
        (tenant_id, student_id) [name: 'idx_payments_tenant_id_student_id']
        (tenant_id, payment_status) [name: 'idx_payments_tenant_id_status']
        (tenant_id, due_date) [name: 'idx_payments_tenant_id_due_date']
    }

    Note: '결제. 매일 자정 배치로 pending → overdue 전환'
}

Table payment_events {
    id binary(16) [pk]
    tenant_id binary(16) [not null]
    payment_id binary(16) [not null]
    event_type varchar(30) [not null, note: 'CHECK: created|paid|overdue_marked|cancelled|refunded|reminder_sent|note_added|adjusted|postponed']
    event_data json
    occurred_at datetime [not null, default: 'CURRENT_TIMESTAMP']
    created_at datetime [not null]
    updated_at datetime [not null]

    Indexes {
        (tenant_id, payment_id, occurred_at) [name: 'idx_payment_events_tenant_id_payment_id_occurred_at']
    }

    Note: '결제 이력 타임라인'
}

Table payment_adjustments {
    id binary(16) [pk]
    tenant_id binary(16) [not null]
    student_id binary(16) [not null]
    type varchar(20) [not null, note: 'CHECK: discount|refund']
    amount decimal(12,2) [not null, note: 'CHECK: >= 0. 학원장 입력값 (자유 입력)']
    reason varchar(500)
    period_start date [note: '부재/할인 시작일 (선택)']
    period_end date [note: '부재/할인 종료일 (선택, CHECK: period_end >= period_start)']
    target_payment_id binary(16) [note: 'discount: 적용 대상 (NULL = 다음 미생성 청구서) / refund: 원 결제 id']
    applied_payment_id binary(16) [note: '실제로 적용된 결제 id (pending → applied 전이 시)']
    status varchar(20) [not null, default: 'pending', note: 'CHECK: pending|applied|cancelled']
    created_by binary(16) [not null, note: 'user_accounts.id (학원장)']
    created_at datetime [not null]
    updated_at datetime [not null]

    Indexes {
        (tenant_id, student_id) [name: 'idx_payment_adjustments_tenant_id_student_id']
        (tenant_id, target_payment_id) [name: 'idx_payment_adjustments_tenant_id_target_payment_id']
        (tenant_id, status) [name: 'idx_payment_adjustments_tenant_id_status']
    }

    Note: '결제 조정 (A 할인 + C 환급 공통 도메인, v1 장부 단계)'
}

Table billing_schedules {
    id binary(16) [pk]
    tenant_id binary(16) [not null]
    student_id binary(16) [not null]
    class_id binary(16) [note: 'NULL 허용. 반 단위 청구 시 클래스 / NULL=학생 단위 청구']
    monthly_fee decimal(12,2) [not null, note: 'CHECK: >= 0. 월 청구액 (payments.amount 대응)']
    anchor_day tinyint [not null, note: 'CHECK: 1~31. 매달 청구일. 말일 클램프(해당월 일수 초과 시 말일) — Backend 계약']
    billing_item varchar(255) [not null, note: '청구 항목명 (payment.billing_item 대응)']
    status varchar(20) [not null, default: 'active', note: 'CHECK: active|paused. 구독 상태']
    last_generated_for_month date [note: '멱등 키 — 마지막 생성 청구월(YYYY-MM-01)·중복청구 방지']
    created_at datetime [not null]
    updated_at datetime [not null]

    Indexes {
        (tenant_id, status, last_generated_for_month) [name: 'idx_billing_schedules_tenant_id_status_last_generated_for_month']
        (tenant_id, student_id) [name: 'idx_billing_schedules_tenant_id_student_id']
    }

    Note: '정기 결제(매달 자동 청구) 생성용 청구 소스 — 구독 단위 청구 룰+멱등 키 (BE daily_billing_generator 소비). payment(할인·부분수금 반영)와 분리한 독립 소스'
}

// ─── §4.5b AI비서 ────────────────────────────────────────────────────────────

Table ai_assistant_unmet_requests {
    id binary(16) [pk]
    tenant_id binary(16) [not null, note: '멀티테넌시 격리(NOT NULL·누락 INSERT 차단). 조회/집계 tenant 범위 한정']
    utterance text [not null, note: '미충족 요청 발화 원문(사용자 입력 그대로). 긴 발화 대비 TEXT']
    captured_at datetime [not null, default: `CURRENT_TIMESTAMP`, note: '캡처 시각 — 집계의 시간 축']
    category varchar(100) [note: 'NULL 허용. 미충족 요청 분류(캡처 시점 미분류 가능·추후 BE/집계 채움 여지)']
    reason varchar(255) [note: 'NULL 허용. 미충족 사유']
    session_id binary(16) [note: 'NULL 허용. 발생 세션 참조(반복 패턴 추적용). 물리 FK 없음(앱 레벨)']
    user_id binary(16) [note: 'NULL 허용. 발화 사용자 참조. 물리 FK 없음(앱 레벨)']
    created_at datetime [not null]

    Indexes {
        (tenant_id, captured_at) [name: 'idx_ai_assistant_unmet_requests_tenant_id_captured_at']
    }

    Note: 'AI비서 미충족 요청 캡처 — 흡수 못한 틀 밖 요청 발화 저장소(append-only·신호 로그·is_deleted 미적용). 자유도 정책 ④ 백로그 캡처. BE-46 INSERT 대상'
}

// ─── §4.6 알림/설정 ──────────────────────────────────────────────────────────

Table message_templates {
    id binary(16) [pk]
    tenant_id binary(16) [not null]
    template_type varchar(50) [not null]
    channel varchar(20) [not null, note: 'CHECK: sms|email|push|kakao']
    title varchar(200)
    body text [not null]
    is_enabled boolean [not null, default: 'TRUE']
    timing_config json [note: 'JSON: 발송 시점 설정']
    created_at datetime [not null]
    updated_at datetime [not null]

    Indexes {
        (tenant_id, template_type, channel) [unique, name: 'uq_message_templates_tenant_id_type_channel']
    }

    Note: '알림 템플릿'
}

Table settings {
    id binary(16) [pk]
    tenant_id binary(16) [not null, unique]
    payment_settings json
    notification_settings json
    auto_attendance_enabled tinyint(1) [not null, default: 1, note: '자동 출결 활성 여부 (DB-31, 20260629). 1=활성(TRUE) 0=비활성(FALSE). 학원별 자동출결 on/off. NOT NULL DEFAULT TRUE = 기존행 전부 활성 backfill·신규행도 활성. BE-61 소비']
    created_at datetime [not null]
    updated_at datetime [not null]

    Note: '학원 설정 (1:1, 학원당 단일 행)'
}

// ─── §4.7 능력치 ────────────────────────────────────────────────────────────

Table ability_tracks {
    id binary(16) [pk]
    tenant_id binary(16) [not null]
    name varchar(100) [not null]
    subject_id binary(16) [note: '종목별 트랙 분리']
    description varchar(500)
    level_thresholds json [note: '등급 임계값 정의 — [{label, min_score, max_score}, ...]. NULL = 등급 미설정. CHECK: JSON_VALID + JSON_TYPE=ARRAY']
    default_score int [not null, default: 0, note: 'CHECK: 0~100. enroll cascade 시 student_abilities.score 초기값']
    created_at datetime [not null]
    updated_at datetime [not null]

    Indexes {
        (tenant_id, name) [unique, name: 'uq_ability_tracks_tenant_id_name']
        (tenant_id, subject_id) [name: 'idx_ability_tracks_tenant_id_subject_id']
    }

    Note: '능력치 트랙 마스터'
}

Table class_ability_tracks {
    id binary(16) [pk]
    tenant_id binary(16) [not null]
    class_id binary(16) [not null]
    ability_track_id binary(16) [not null]
    created_at datetime [not null]
    updated_at datetime [not null]

    Indexes {
        (tenant_id, class_id, ability_track_id) [unique, name: 'uq_class_ability_tracks_tenant_class_track']
        (tenant_id, class_id) [name: 'idx_class_ability_tracks_tenant_class']
        (tenant_id, ability_track_id) [name: 'idx_class_ability_tracks_tenant_track']
    }

    Note: '클래스 ↔ 능력치 트랙 N:M 매핑. 학생 enroll 시 cascade 로 student_abilities row 자동 생성'
}

Table student_abilities {
    id binary(16) [pk]
    tenant_id binary(16) [not null]
    student_id binary(16) [not null]
    ability_track_id binary(16) [not null]
    score int [not null, default: 0, note: 'CHECK: 0~100. default_score 타입 정합 (F=X)']
    evaluated_at datetime [note: 'NULL = enroll cascade 자동 초기화 (미평가), NOT NULL = 학원장 명시 평가 시각']
    created_at datetime [not null]
    updated_at datetime [not null]

    Indexes {
        (tenant_id, student_id, ability_track_id) [unique, name: 'uq_student_abilities_tenant_id_student_id_track_id']
        (tenant_id, student_id) [name: 'idx_student_abilities_tenant_id_student_id']
    }

    Note: '학생별 능력치 평가'
}

// ─── §4.8 업로드 메타 ────────────────────────────────────────────────────────

Table uploads {
    id binary(16) [pk]
    tenant_id binary(16) [not null]
    purpose varchar(50) [not null, note: 'CHECK: student_profile|teacher_profile|academy_logo|vision_image|other']
    object_key varchar(500) [not null, unique]
    original_filename varchar(255)
    content_type varchar(100)
    byte_size bigint [note: 'unsigned']
    upload_status varchar(20) [not null, default: 'pending', note: 'CHECK: pending|uploading|processing|completed|failed']
    processed_url varchar(500)
    thumbnail_url varchar(500)
    created_by_user_account_id binary(16)
    created_at datetime [not null]
    updated_at datetime [not null]

    Indexes {
        (tenant_id, purpose) [name: 'idx_uploads_tenant_id_purpose']
        (tenant_id, upload_status) [name: 'idx_uploads_tenant_id_status']
    }

    Note: '업로드 메타 (presigned URL 추적). 후처리 상태 머신'
}

// ─── §4.9 학기 (RG_Director 요청 추가, 2026-05-10) ───────────────────────────

Table semesters {
    id binary(16) [pk]
    tenant_id binary(16) [not null]
    name varchar(40) [not null, note: '예: 2026-1학기']
    starts_on date [not null]
    ends_on date [not null, note: 'CHECK: ends_on >= starts_on']
    is_current boolean [not null, default: 'FALSE']
    description varchar(200)
    current_flag binary(16) [note: 'GENERATED ALWAYS AS (IF(is_current=TRUE, tenant_id, NULL)) VIRTUAL — 학원당 is_current=TRUE 단일 보장 (partial UNIQUE 우회)']
    created_at datetime [not null]
    updated_at datetime [not null]

    Indexes {
        (tenant_id, starts_on) [name: 'idx_semesters_tenant_id_starts_on']
        current_flag [unique, name: 'uq_semesters_tenant_current']
    }

    Note: '학기 — 현재 학기 표시(GET /settings/operation.current_semester) + v2 학기별 통계'
}

// ─── 마이그레이션 추적 (dbmate) ──────────────────────────────────────────────

Table schema_migrations {
    version varchar(255) [pk, note: 'YYYYMMDDHHMMSS 형식']

    Note: 'dbmate 자동 관리. 적용된 마이그레이션 버전 추적'
}

// ============================================================================
// Refs (시각화 전용 — 회신 §3-4 정책에 따라 DB에는 FK 미선언)
// ON DELETE 의도는 회신 §3-4.3 표 참조 (앱 트랜잭션에서 처리)
// ============================================================================

// 멀티테넌시 (모든 도메인 → academies)
Ref: user_accounts.tenant_id > academies.id [delete: restrict]
Ref: refresh_tokens.tenant_id > academies.id [delete: restrict]
Ref: students.tenant_id > academies.id [delete: restrict]
Ref: student_notes.tenant_id > academies.id [delete: restrict]
Ref: subjects.tenant_id > academies.id [delete: restrict]
Ref: rooms.tenant_id > academies.id [delete: restrict]
Ref: teachers.tenant_id > academies.id [delete: restrict]
Ref: classes.tenant_id > academies.id [delete: restrict]
Ref: student_classes.tenant_id > academies.id [delete: restrict]
Ref: holidays.tenant_id > academies.id [delete: restrict]
Ref: attendances.tenant_id > academies.id [delete: restrict]
Ref: vision_verifications.tenant_id > academies.id [delete: restrict]
Ref: payments.tenant_id > academies.id [delete: restrict]
Ref: payment_events.tenant_id > academies.id [delete: restrict]
Ref: message_templates.tenant_id > academies.id [delete: restrict]
Ref: settings.tenant_id > academies.id [delete: restrict]
Ref: ability_tracks.tenant_id > academies.id [delete: restrict]
Ref: student_abilities.tenant_id > academies.id [delete: restrict]
Ref: uploads.tenant_id > academies.id [delete: restrict]
Ref: semesters.tenant_id > academies.id [delete: restrict]

// 인증
Ref: refresh_tokens.user_account_id > user_accounts.id [delete: cascade]

// 학생 → 부속
Ref: student_notes.student_id > students.id [delete: cascade]
Ref: student_classes.student_id > students.id [delete: cascade]
Ref: student_abilities.student_id > students.id [delete: cascade]
Ref: attendances.student_id > students.id [delete: restrict]
Ref: payments.student_id > students.id [delete: restrict]
Ref: vision_verifications.student_id > students.id [delete: restrict]
Ref: billing_schedules.student_id > students.id [delete: restrict]
Ref: payment_adjustments.student_id > students.id [delete: restrict]

// 클래스
Ref: student_classes.class_id > classes.id [delete: cascade]
Ref: attendances.class_id > classes.id [delete: restrict]
Ref: payments.class_id > classes.id [delete: restrict]
Ref: classes.subject_id > subjects.id [delete: restrict]
Ref: classes.teacher_id > teachers.id [delete: restrict]
Ref: classes.room_id > rooms.id [delete: set null]

// 강사
Ref: teachers.subject_id > subjects.id [delete: restrict]

// 결제
Ref: payment_events.payment_id > payments.id [delete: cascade]

// 출결-Vision
Ref: attendances.vision_verification_id > vision_verifications.id [delete: set null]

// 능력치
Ref: ability_tracks.subject_id > subjects.id [delete: restrict]
Ref: student_abilities.ability_track_id > ability_tracks.id [delete: cascade]

// 업로드
Ref: uploads.created_by_user_account_id > user_accounts.id [delete: set null]


// ============================================================================
// §5 Phase 5 — Person-centric 모델 v1 (2026-05-28)
// ============================================================================
//
// 합의 근거: Document/RG_Database/2026-05-28-user-add-process-supplement.md
// Backend v2 response (B1' guardian-first / B5 X / B6 X / B9 Y audit / B10 Z)
//
// 모델: 학원장 격리 유지 + 글로벌 persons / guardians 도입
// 마이그레이션: 5건 (persons / guardians / guardian_persons / guardian_consents / person_link_requests)
// students.person_id ALTER 는 별도 마이그 6 (사용자 발화 후 진입) — 본 v1 미포함
// ============================================================================

TableGroup phase5_person_centric [color: #a855f7] {
    persons
    guardians
    guardian_persons
    guardian_consents
    person_link_requests
}

Table persons {
    id binary(16) [pk]
    name varchar(100) [not null]
    birth_date date
    gender varchar(10) [note: 'CHECK: NULL or male|female|other']
    created_at datetime [not null]
    updated_at datetime [not null]

    Indexes {
        (name, birth_date) [name: 'idx_persons_name_birth']
    }

    Note: '글로벌 인물 (학생/아이) — 학부모 앱 통합 뷰 SOURCE (B5 X: 최소 식별자만)'
}

Table guardians {
    id binary(16) [pk]
    phone varchar(20) [not null, note: 'B1'' 1차 lookup 키 — exact match']
    name varchar(100) [not null]
    email varchar(255)
    password_hash varchar(255) [note: 'B4'' SMS OTP 통일 — 비밀번호 인증 옵션']
    last_login_at datetime
    created_at datetime [not null]
    updated_at datetime [not null]

    Indexes {
        phone [unique, name: 'uq_guardians_phone']
    }

    Note: '글로벌 보호자 계정 (학부모 앱) — user_accounts 와 별도 인증 stack (B6 X)'
}

Table guardian_persons {
    id binary(16) [pk]
    guardian_id binary(16) [not null]
    person_id binary(16) [not null]
    relationship varchar(20) [not null, note: 'mother | father | guardian | grandparent | other']
    created_at datetime [not null]

    Indexes {
        (guardian_id, person_id) [unique, name: 'uq_guardian_persons']
        person_id [name: 'idx_guardian_persons_person']
    }

    Note: '보호자 ↔ 아이 N:M 매핑 (claimed 상태) — 형제자매 자동 그룹 매칭 SOURCE (B10 Z)'
}

Table guardian_consents {
    id binary(16) [pk]
    guardian_id binary(16) [not null]
    person_id binary(16) [not null]
    action varchar(30) [not null, note: 'CHECK: claim_person | link_to_academy | revoke | reauth']
    otp_verified_at datetime [not null, note: 'SMS OTP 검증 완료 시각']
    consented_at datetime [not null]
    revoked_at datetime [note: 'NULL=활성 / NOT NULL=철회됨']
    ip_address varchar(45) [note: 'IPv4/IPv6 audit 보강']
    user_agent varchar(255) [note: 'client UA audit 보강']

    Indexes {
        (guardian_id, consented_at) [name: 'idx_consents_guardian']
        (person_id, consented_at) [name: 'idx_consents_person']
    }

    Note: '학부모 동의 audit (개인정보보호법 시행령 §29 정합, B9 Y)'
}

Table person_link_requests {
    id binary(16) [pk]
    tenant_id binary(16) [not null]
    student_id binary(16) [not null]
    person_id binary(16) [not null]
    initiator varchar(20) [not null, note: 'CHECK: academy (Type A'') | guardian (Type B)']
    status varchar(20) [not null, default: 'pending', note: 'CHECK: pending | approved | rejected | expired']
    requested_at datetime [not null]
    resolved_at datetime
    expires_at datetime [not null, note: 'B2 Z — 30일 권장']

    Indexes {
        (tenant_id, status) [name: 'idx_plr_tenant_status']
        (person_id, status) [name: 'idx_plr_person_status']
    }

    Note: '학원 ↔ 학생 ↔ person 매칭 요청 워크플로우 (Type A''/B)'
}

// Phase 5 논리 참조 (FK 미선언 — 시각화 전용)
Ref: guardian_persons.guardian_id > guardians.id [delete: restrict]
Ref: guardian_persons.person_id > persons.id [delete: restrict]
Ref: guardian_consents.guardian_id > guardians.id [delete: restrict]
Ref: guardian_consents.person_id > persons.id [delete: restrict]
Ref: person_link_requests.person_id > persons.id [delete: restrict]
Ref: person_link_requests.student_id > students.id [delete: cascade]
Ref: students.person_id > persons.id [delete: restrict]  // Phase 5 마이그 6 — 1:1 backfill 후 NOT NULL
