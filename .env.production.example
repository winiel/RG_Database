# ============================================================================
# RG_Database — AWS production 접속 정본(.env.production) 샘플 · Secrets Manager 기반
#
# ⚠️ 이 파일이 가리키는 RDS 는 **production 단일 인스턴스**다.
#    2026-06-10(DB-4) 부로 dev/production 이 단일화되어 **별도 dev 환경은 없다**.
#    파일명이 곧 환경이다 — 여기 채운 값으로 로컬에서 기동하면 **실 운영 데이터에 직결**된다.
#    파괴적 작업 전 백업 2종(mysqldump + RDS 스냅샷) 필수.
#    (구 파일명 `.env.aws-dev` — 위니엘님 지시로 DB-48 에서 `.env.production` 으로 리네이밍 완료)
#
# ── env 파일 규약 (정본: RG_Common `docs/ops/env-files-convention.md` §1 · 2026-09-07)
#   .env          이 머신에서 지금 활성인 파일 — "역할"이 아니라 "자리"다
#   .env.local    로컬 전용 개인·비밀 값으로 .env 를 덮어씀 (RG_Database 는 현재 미사용)
#   .env.production  AWS production 환경에서 사용하는 정본 소스
#   → 정본(.env.local / .env.production) → 배치(.env) 관계. 배포 시 정본 내용을 .env 자리에 둔다.
#
# 키 취급: 실 .env* 파일은 **git 커밋 금지**(.gitignore `.env.*`). 추적 대상은 `.example` 뿐이며
#          값 자리는 항상 비운다(RDS endpoint·ARN 은 민감도가 낮아도 placeholder 유지).
#          DB 패스워드는 파일에 두지 않는다 — **Secrets Manager 만** 사용.
#
# 사용:
#   cp .env.production.example .env.production
#   # → .env.production 을 실제 값으로 채우기
#   source scripts/aws-dev/load-master-secret.sh   # 이 스크립트가 .env.production 을 직접 로드
#   dbmate up
# ============================================================================

AWS_PROFILE=projectrg
AWS_DEFAULT_REGION=ap-northeast-2

# RDS endpoint (Phase 2 생성 직후 채워넣음)
RDS_HOST=projectrg-dev-db-rds.XXXXXXXX.ap-northeast-2.rds.amazonaws.com
RDS_PORT=3306
RDS_DB_NAME=ProjectRG_Dev

# Master 패스워드 Secret ARN (RDS managed)
MASTER_SECRET_ARN=arn:aws:secretsmanager:ap-northeast-2:XXXXXXXXXXXX:secret:rds!db-XXXXXXXX

# App user 패스워드 Secret ARN (Phase 5에서 추가)
# APP_USER_SECRET_ARN=arn:aws:secretsmanager:ap-northeast-2:XXXXXXXXXXXX:secret:projectrg/dev/app-user-XXX
