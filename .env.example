# ============================================================================
# RG_Database — 환경 변수 샘플 (로컬 개발용 · .env 자리에 배치)
#
# ── env 파일 규약 (정본: RG_Common `docs/ops/env-files-convention.md` §1 · 2026-09-07)
#   .env          이 머신에서 지금 활성인 파일 — "역할"이 아니라 "자리"다
#   .env.local    로컬 전용 개인·비밀 값으로 .env 를 덮어씀 (RG_Database 는 현재 미사용)
#   .env.production  AWS production 환경에서 사용하는 정본 소스
#   → 정본(.env.local / .env.production) → 배치(.env) 관계. 배포 시 정본 내용을 .env 자리에 둔다.
#
# 키 취급: 실 .env* 파일은 **git 커밋 금지**(.gitignore `.env.*`). 추적 대상은 `.example` 뿐이며
#          값 자리는 항상 비운다. DB 패스워드 평문 보관 금지 — Secrets Manager 사용(AWS 경로).
# ============================================================================

# ----- 로컬 개발 (MySQL on localhost) -----
DATABASE_URL="mysql://root@127.0.0.1:3306/ProjectRG_Dev"
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ProjectRG_Dev
DB_USER=root
DB_PASSWORD=

# ----- 마이그레이션 도구 (dbmate, Phase 1 후반 도입 예정) -----
DBMATE_MIGRATIONS_DIR=./migrations
DBMATE_SCHEMA_FILE=./schema/schema.sql
DBMATE_NO_DUMP_SCHEMA=false

# ----- 백엔드 애플리케이션 계정 (Phase 1 종료 시점에 GRANT 적용) -----
# APP_DB_USER=projectrg_app
# APP_DB_PASSWORD=

# ----- 마이그레이션 계정 (DDL 권한) -----
# MIGRATOR_DB_USER=projectrg_migrator
# MIGRATOR_DB_PASSWORD=

# ----- 타임존 (정책: UTC 저장) -----
# 인스턴스 my.cnf 또는 RDS 파라미터 그룹: default-time-zone='+00:00'
# 세션 단위 강제: SET time_zone = '+00:00';
